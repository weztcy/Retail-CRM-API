// Prisma Schema CRM Retail
// Backend: Next.js API
// Database: MySQL
// ORM: Prisma 7.10.0

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// =========================
// USER & AUTHENTICATION
// =========================

model User {
  id String @id @default(uuid())

  name String

  email String @unique

  passwordHash String

  role Role @default(SALES)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  activities CustomerActivity[]

  auditLogs AuditLog[]

  refreshTokens RefreshToken[]

  transactions Transaction[]

  inventoryTransactions InventoryTransaction[]
}

// =========================
// CUSTOMER CRM
// =========================

model Customer {

  id String @id @default(uuid())


  customerCode String @unique


  name String


  phone String @unique


  email String?


  imageUrl String?


  isActive Boolean @default(true)


  gender Gender?


  birthDate DateTime?


  address String?


  city String?


  membership MembershipLevel @default(BRONZE)


  totalSpent Decimal @default(0) @db.Decimal(12, 2)


  createdAt DateTime @default(now())


  updatedAt DateTime @updatedAt


  transactions Transaction[]


  activities CustomerActivity[]


  loyalty LoyaltyAccount?



  @@index([name])

  @@index([phone])

  @@index([email])

  @@index([city])

  @@index([membership])

  @@index([isActive])

  @@index([isActive, createdAt])
  
  @@index([isActive, membership])
  
  @@index([isActive, city])
}

// =========================
// CUSTOMER ACTIVITY
// =========================

model CustomerActivity {
  id String @id @default(uuid())

  customerId String

  userId String

  type ActivityType

  subject String

  description String?

  status ActivityStatus @default(PENDING)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id])

  @@index([customerId])
  @@index([userId])
}

// =========================
// PRODUCT
// =========================

model Product {
  id String @id @default(uuid())

  sku String @unique

  name String

  category String

  imageUrl String?

  price Decimal @db.Decimal(12, 2)

  stock Int @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  transactionItems TransactionItem[]

  inventoryTransactions InventoryTransaction[]

  @@index([name])
  @@index([category])
}

// =========================
// TRANSACTION
// =========================

model Transaction {
  id String @id @default(uuid())

  invoiceNumber String @unique

  customerId String

  userId String

  totalAmount Decimal @db.Decimal(12, 2)

  paymentMethod PaymentMethod

  paymentStatus PaymentStatus @default(PAID)

  status TransactionStatus @default(COMPLETED)

  paymentReference String?

  notes String?

  transactionDate DateTime @default(now())

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])

  user User @relation(fields: [userId], references: [id])

  items TransactionItem[]

  inventoryTransactions InventoryTransaction[]

  loyaltyHistories LoyaltyHistory[]

  @@index([customerId])
  @@index([userId])
  @@index([invoiceNumber])
  @@index([transactionDate])
}

// =========================
// TRANSACTION DETAIL
// =========================

model TransactionItem {
  id String @id @default(uuid())

  transactionId String

  productId String

  quantity Int

  price Decimal @db.Decimal(12, 2)

  subtotal Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id])

  @@index([transactionId])
  @@index([productId])
}

// =========================
// AUDIT LOG
// =========================

model AuditLog {
  id String @id @default(uuid())

  userId String

  action String

  module String

  description String?

  ipAddress String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([module])
}

// =========================
// REFRESH TOKEN
// =========================

model RefreshToken {
  id String @id @default(uuid())

  userId String

  token String @unique @db.VarChar(512)

  expiresAt DateTime

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// =========================
// INVENTORY TRANSACTION
// =========================

model InventoryTransaction {
  id String @id @default(uuid())

  productId String

  userId String

  transactionId String?

  type InventoryType

  quantity Int

  stockBefore Int

  stockAfter Int

  description String?

  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])

  user User @relation(fields: [userId], references: [id])

  transaction Transaction? @relation(fields: [transactionId], references: [id])

  @@index([productId])
  @@index([userId])
  @@index([transactionId])
}

// =========================
// LOYALTY
// =========================

model LoyaltyAccount {
  id String @id @default(uuid())

  customerId String @unique

  points Int @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  histories LoyaltyHistory[]
}

// =========================
// LOYALTY HISTORY
// =========================

model LoyaltyHistory {
  id String @id @default(uuid())

  loyaltyAccountId String

  transactionId String?

  type LoyaltyHistoryType

  points Int

  description String?

  createdAt DateTime @default(now())

  loyaltyAccount LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)

  transaction Transaction? @relation(fields: [transactionId], references: [id])

  @@index([loyaltyAccountId])
  @@index([transactionId])
  @@index([createdAt])
}

// =========================
// ENUMS
// =========================

enum Role {
  SUPER_ADMIN

  ADMIN

  MANAGER

  SALES

  CUSTOMER_SERVICE
}

enum Gender {
  MALE

  FEMALE

  OTHER
}

enum MembershipLevel {
  BRONZE

  SILVER

  GOLD

  PLATINUM
}

enum ActivityType {
  CALL

  WHATSAPP

  EMAIL

  MEETING

  COMPLAINT

  NOTE
}

enum ActivityStatus {
  PENDING

  PROCESS

  DONE

  CANCELLED
}

enum PaymentMethod {
  CASH

  CARD

  TRANSFER

  EWALLET

  QRIS
}

enum PaymentStatus {
  UNPAID

  PAID

  REFUND
}

enum TransactionStatus {
  PENDING

  PROCESSING

  COMPLETED

  CANCELLED
}

enum InventoryType {
  STOCK_OUT

  STOCK_IN

  ADJUSTMENT
}

enum LoyaltyHistoryType {
  EARN

  ROLLBACK
}
